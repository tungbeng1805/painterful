<div class="hdt-grid-system hdt-grid-system-12 {{ block.settings.rounded }} hdt-oh" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>
{% schema %}
  {
    "name": "Multi row 12",
    "tag":null,
    "blocks": [
      {
        "type": "_multi_column"
      }
    ],
    "settings": [
      {
        "type": "select",
        "id": "rounded",
        "label": "Rounded",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "hdt-rounded-xs",
            "label": "Extra small"
          },
          {
            "value": "hdt-rounded-sm",
            "label": "Small"
          },
          {
            "value": "hdt-rounded",
            "label": "Medium"
          },
          {
            "value": "hdt-rounded-lg",
            "label": "Large"
          },
          {
            "value": "hdt-rounded-full",
            "label": "Full"
          }
        ],
        "default": "none"
      },
    ],
    "presets": [
      {
        "name": "Multi row 12"
      }
    ]
  }
{% endschema %}
