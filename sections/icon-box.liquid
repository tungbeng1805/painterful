{{ 'hdt-icon-box.css' | asset_url | stylesheet_tag }}
{% style %}
  #{{ section.id }}{
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px; 
    --section-prate: {{ section.settings.padding_rate }};
    --spacing-item-dk: {{ section.settings.spacing_dk }}px;
    --spacing-item-tb: {{ section.settings.spacing_tb }}px;
    --spacing-item-mb: {{ section.settings.spacing_mb }}px;
  }
{% endstyle %}
{%- if section.settings.carousel_mobile -%}
  {%- capture scrollsnap_dots -%}
    <div class="hdt-icon-box__scrollsnap-dots hdt-scrollsnap-dots hdt-text-center hdt-hidden">
      {%- for block in section.blocks -%}
        <button class="hdt-scrollsnap-dot__link hdt-scrollsnap-dot"></button> 
      {%- endfor -%}
    </div>
  {%- endcapture -%}
  {%- assign sm_snap_flex = ' sm:hdt-snap-flex' -%}
{%- endif -%}
{%- liquid
  
-%}
<div id="{{ section.id }}" class="hdt-s-inner {% if section.settings.color_wrap != 'container' %} hdt-s-gradient hdt-section-spacing{% endif %}" color-scheme="{{ section.settings.color_scheme }}" hdt-reveal="fade-in">
  <div class="hdt-container">
    <hdt-scrollsnap class="{% if section.settings.color_wrap == 'container' %} hdt-s-gradient hdt-rounded hdt-section-spacing{% endif %}">
      {% content_for 'block', type: 'section-heading', id: 'icon-box' %}
      <div id="Scroller-{{ section.id }}" class="hdt-text-{{ section.settings.content_align }} {% if section.settings.icon_circle %} hdt-icon-box__icon-circle{% endif %} hdt-icon-box__border-{{ section.settings.border_style }} hdt-row-flex hdt-flex-cols-{{ section.settings.col_mb }} md:hdt-flex-cols-{{ section.settings.col_tb }} lg:hdt-flex-cols-{{ section.settings.col_dk }} hdt-spacing-x md:hdt-justify-center hdt-scroll-snap hdt-snap-x{{ sm_snap_flex }}">
        {% content_for "blocks" %}
      </div>
      {{- scrollsnap_dots -}}
    </hdt-scrollsnap>
  </div>
</div>
{%- if section.settings.carousel_mobile and section.settings.auto_next -%}
  <script>
    (() => {
      const sectionId = {{ section.id | json }};
      const scroller = document.getElementById(`Scroller-${sectionId}`);
      if (!scroller || scroller.dataset.autoNextBound === "true") return;

      const delay = Math.max(1, Number({{ section.settings.auto_next_time | json }})) * 1000;
      const dots = [...(scroller.parentElement?.querySelectorAll(".hdt-icon-box__scrollsnap-dots .hdt-scrollsnap-dot__link") || [])];
      const items = [...scroller.querySelectorAll(":scope > .hdt-group-block, :scope > *")].filter((item) => item.nodeType === 1);
      if (dots.length < 2 && items.length < 2) return;

      let currentIndex = 0;
      scroller.dataset.autoNextBound = "true";

      const goToIndex = (index) => {
        if (dots.length > 0) {
          dots[index]?.click();
          return;
        }
        const target = items[index];
        target?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
      };

      const next = () => {
        const length = dots.length > 0 ? dots.length : items.length;
        currentIndex = (currentIndex + 1) % length;
        goToIndex(currentIndex);
      };

      let timer = setInterval(next, delay);

      scroller.addEventListener("scroll", () => {
        if (dots.length > 0 || !items.length) return;
        let nearestIndex = 0;
        let nearestDistance = Number.POSITIVE_INFINITY;
        const currentLeft = Math.round(scroller.scrollLeft);
        items.forEach((item, index) => {
          const itemLeft = Math.round(item.offsetLeft - scroller.offsetLeft);
          const distance = Math.abs(itemLeft - currentLeft);
          if (distance < nearestDistance) {
            nearestDistance = distance;
            nearestIndex = index;
          }
        });
        currentIndex = nearestIndex;
      }, { passive: true });

      if (dots.length > 0) {
        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            currentIndex = index;
          }, { passive: true });
        });
      }

      scroller.addEventListener("pointerdown", () => {
        clearInterval(timer);
      }, { passive: true });

      scroller.addEventListener("pointerup", () => {
        clearInterval(timer);
        timer = setInterval(next, delay);
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
