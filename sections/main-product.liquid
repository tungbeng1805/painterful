<!-- sections/main-product.liquid -->
{% liquid
  assign un_no_pick = true
  if settings.pick_mode == 'no' and product.variants.size > 1
    assign selected_variant = product.selected_variant
    unless selected_variant
      assign un_no_pick = false
    endunless
  elsif settings.pick_mode == 'first' and settings.hide_sold_out == false
    assign selected_variant = product.selected_variant | default: product.variants.first
  else
    assign selected_variant = product.selected_or_first_available_variant
  endif
  assign product_form_id = 'product-form-'| append: section.id | append: product.id
%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --pr-media-width: {{ section.settings.media_width }}%; --section-pt:{{ section.settings.padding_top }}px; --section-pb:{{ section.settings.padding_bottom }}px; --section-prate:{{ section.settings.padding_rate }};
  }
{%- endstyle -%}
<div class="hdt-s-inner hdt-s-gradient" color-scheme="{{ section.settings.color_scheme }}" hdt-reveal="fade-in">
  <div class="hdt-container {%- if section.settings.full_width -%}-full{%- endif %}">
    <div class="hdt-section-spacing">
      <div class="hdt-secion-main-product--{{ section.id }} hdt-row-grid hdt-grid-cols-1 md:hdt-grid-cols-2 hdt-main-product-wrap">
        {% content_for 'block', type: '_product-medias', id: 'main-product' %}
        {% content_for "blocks" %}
      </div>
      {%- if section.settings.product_list_fbt != blank -%}
        <div color-scheme="{{ section.settings.fbt_color_scheme }}">
          {% render 'product-form-bundle2', product_list: section.settings.product_list_fbt, product: product %}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.sticky_atc and product.available and request.page_type == 'product' -%}
    {%- liquid
      unless un_no_pick
      assign selected_variant = product.variants.first
      endunless
      assign check_against_inventory = true
      if selected_variant.inventory_management != 'shopify' or selected_variant.inventory_policy == 'continue'
        assign check_against_inventory = false
      endif
      if selected_variant.quantity_rule.min > selected_variant.inventory_quantity and check_against_inventory
        assign quantity_rule_soldout = true
      endif
      if selected_variant.inventory_management == 'shopify' and selected_variant.inventory_quantity <= 0 and selected_variant.available
        assign is_pre_order = true
      else
        assign is_pre_order = false
      endif
      assign product_form_id_sticky = 'form-product-sticky' | append: product.id
  
      assign id_sticky = 'sticky-' | append: section.id
      assign image = selected_variant.featured_image | default: product.featured_image | default: settings.placeholder_img
    -%}
  {{ 'hdt-sticky-atc.css' | asset_url | stylesheet_tag }}
  <hdt-sticky-btn-atc form="{{ product_form_id }}" {% if product.has_only_default_variant %}is-pr-default {% endif %} color-scheme="{{ section.settings.color_scheme }}" class="hdt-sticky-btn-atc hdt-sticky_layout_mb--minimal hdt-s-gradient">
    <div class="hdt-container">
      <hdt-height-observer prefix="hdt-sticky-atc" class="hdt-flex hdt-align-center hdt-justify-center">
        <div class="hdt-sticky-atc__product hdt-flex hdt-align-center">
          <div class="hdt-sticky-atc__img hdt-rounded-full hdt-oh hdt-relative">
            {%- if image != blank -%}
              {{ image | image_url: width: image.width | image_tag: loading: 'lazy', sizes: '80px', widths: '80, 160', data-widths: '[80, 160]', data-v-img: '' }}
            {%- else -%}
                <span class="hdt-sticky-atc__img-placeholder"></span>
            {%- endif -%}
          </div>
          <div class="hdt-sticky-atc__product-infos">
            <h3 class="hdt-sticky-atc__title hdt-text-lg hdt-font-medium hdt-hidden lg:hdt-block">{{ product.title }}</h3>
          </div>
        </div>
        <div class="hdt-sticky-atc__infos">
          <wrapp-hdt-pr-frm class="hdt-contents">
            {%- form 'product', product, id: product_form_id_sticky, class: 'hdt-sticky-atc__form hdt-flex hdt-align-center', data-gift-card-recipient: false -%}
              <div class="hdt-sticky-atc__variant-price">
                {%- unless product.has_only_default_variant -%}
                  <select name="id" class="hdt-select hdt-s-text hdt-truncate" tag-select>
                    {%- for variant in product.variants -%}
                      <option data-mdid="{{ variant.featured_media.id }}" {% if variant == selected_variant %}selected="selected"{% endif %}{% if variant.available == false %} disabled {% endif %} value="{{ variant.id }}">
                        {%- liquid
                          echo variant.title
                          unless settings.currency_type == "2"
                            echo variant.price | money | strip_html | prepend: ' - '
                          endunless
                          if variant.available == false
                            echo 'products.product.sold_out' | t | prepend: ' - '
                          endif
                        -%}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ selected_variant.id }}">
                  <span class="hdt-sticky-atc__product-monney hdt-money hdt-text-lg">{{ product.price | money }}</span>
                {%- endunless -%}
              </div>
              <div class="hdt-sticky-atc__btns hdt-flex hdt-align-center">
                <div class="hdt-sticky-atc__qty-selector">
                  {%- render 'product-qty-selector', selected_variant: selected_variant, product_form_id: product_form_id_sticky, id: id_sticky -%}
                </div>
                <button type="submit" name="add" class="hdt-sticky-atc__submit hdt-btn hdt-oh hdt-btn-solid hdt-font-semibold hdt-relative hdt-truncate hdt-btn-loading__svg"{% if selected_variant.available == false or quantity_rule_soldout %} disabled="true"{% endif %}>
                  <span class="hdt-btn-atc_text">{% if is_pre_order %}{{ 'products.product.pre_order' | t }}{% elsif selected_variant.available == false or quantity_rule_soldout %}{{ 'products.product.sold_out' | t }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endif %}</span> 
                  <span class="hdt-loading__spinner hdt-absolute" hidden>
                    <svg width="16" height="16" class="hdt-svg-spinner" focusable="false" role="presentation" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="hdt-path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                  </span>
                </button>
              </div>
            {%- endform -%}
          </wrapp-hdt-pr-frm>
        </div>
      </hdt-height-observer>
    </div>
  </hdt-sticky-btn-atc>
  {%- endif -%}
</div>
<script>
  (() => {
    const SELECTOR_ATC_BUTTONS = [
      '.hdt-product-form__submit.hdt-btn',
      '.hdt-sticky-atc__submit.hdt-btn'
    ].join(',');
    const MODAL_ID = 'hdt-atc-validation-modal';

    function ensureValidationModal() {
      let modal = document.getElementById(MODAL_ID);
      if (modal) return modal;

      modal = document.createElement('div');
      modal.id = MODAL_ID;
      modal.setAttribute('aria-hidden', 'true');
      modal.style.cssText = 'position:fixed;inset:0;display:none;z-index:99999;';
      modal.innerHTML = `
        <div data-role="overlay" style="position:absolute;inset:0;background:rgba(0,0,0,.5);"></div>
        <div style="position:relative;z-index:1;display:flex;min-height:100%;align-items:center;justify-content:center;padding:16px;">
          <div role="dialog" aria-modal="true" style="width:100%;max-width:420px;background:#fff;border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.2);padding:18px 16px 14px;">
            <div data-role="title" style="font-size:18px;line-height:1.3;font-weight:700;color:#222;margin-bottom:8px;">Notice</div>
            <div data-role="message" style="font-size:14px;line-height:1.45;color:#444;margin-bottom:14px;"></div>
            <div data-role="actions" style="display:flex;gap:8px;justify-content:flex-end;"></div>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      return modal;
    }

    function showPopup(options) {
      const modal = ensureValidationModal();
      const titleEl = modal.querySelector('[data-role="title"]');
      const messageEl = modal.querySelector('[data-role="message"]');
      const actionsEl = modal.querySelector('[data-role="actions"]');
      const overlayEl = modal.querySelector('[data-role="overlay"]');

      const title = options?.title || 'Notice';
      const message = options?.message || '';
      const okText = options?.okText || 'OK';
      const cancelText = options?.cancelText || '';
      const okStyle = options?.okStyle || 'primary';

      titleEl.textContent = title;
      messageEl.textContent = message;
      actionsEl.innerHTML = '';

      return new Promise((resolve) => {
        const close = (result) => {
          modal.style.display = 'none';
          modal.setAttribute('aria-hidden', 'true');
          document.removeEventListener('keydown', onEsc, true);
          resolve(result);
        };

        const onEsc = (ev) => {
          if (ev.key === 'Escape') close(false);
        };
        document.addEventListener('keydown', onEsc, true);

        if (cancelText) {
          const cancelBtn = document.createElement('button');
          cancelBtn.type = 'button';
          cancelBtn.textContent = cancelText;
          cancelBtn.style.cssText = 'border:1px solid #ddd;background:#fff;color:#333;padding:10px 14px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;';
          cancelBtn.onclick = () => close(false);
          actionsEl.appendChild(cancelBtn);
        }

        const okBtn = document.createElement('button');
        okBtn.type = 'button';
        okBtn.textContent = okText;
        okBtn.style.cssText = okStyle === 'danger'
          ? 'border:1px solid #d92d20;background:#d92d20;color:#fff;padding:10px 14px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;'
          : 'border:1px solid #be5637;background:#be5637;color:#fff;padding:10px 14px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;';
        okBtn.onclick = () => close(true);
        actionsEl.appendChild(okBtn);

        overlayEl.onclick = () => close(false);
        modal.style.display = 'block';
        modal.setAttribute('aria-hidden', 'false');
        setTimeout(() => okBtn.focus(), 0);
      });
    }

    function getFormFromSubmitButton(btn) {
      if (!btn) return null;
      if (btn.form instanceof HTMLFormElement) return btn.form;
      const formId = btn.getAttribute && btn.getAttribute('form');
      if (formId) return document.getElementById(formId);
      return btn.closest('form');
    }

    function getUploadPickerForForm(form) {
      if (!form?.id) return null;
      const picker = document.querySelector(
        `input.hdt-upload-input[data-product-form-id="${form.id}"][data-required="true"]`
      );
      if (picker) return picker;
      // Fallback: if theme submits a different form (sticky), reuse any required picker on page
      return document.querySelector('input.hdt-upload-input[data-required="true"]');
    }

    function countUploadedFilesForForm(form) {
      // Prefer the global cache populated by `_product-item-property.liquid`
      const map = window.__hdtUploadFilesByFormAndLabel;
      const byLabel = (form?.id && map && map[form.id]) ? map[form.id] : null;
      if (byLabel && typeof byLabel === 'object') {
        let total = 0;
        for (const files of Object.values(byLabel)) {
          if (Array.isArray(files)) total += files.length;
        }
        return total;
      }

      // Fallback: count preview images in the upload block (if present)
      const picker = getUploadPickerForForm(form);
      const root = picker?.closest?.('.hdt-line-item-property');
      const preview = root?.querySelector?.('.hdt-upload-preview');
      const imgs = preview ? preview.querySelectorAll('img') : null;
      return imgs ? imgs.length : 0;
    }

    function setInlineValidation(picker, message) {
      if (!picker) return;
      const root = picker.closest('.hdt-line-item-property') || picker.parentElement;
      if (!root) return;

      let el = root.querySelector('.hdt-upload-validation');
      if (!el) {
        el = document.createElement('div');
        el.className = 'hdt-upload-validation';
        el.style.cssText = 'margin-top:8px;color:#ff0000;font-size:13px;line-height:1.3;font-weight:500;';
        root.appendChild(el);
      }
      el.textContent = message || '';
      el.hidden = !message;
    }

    function focusUploadArea(picker) {
      if (!picker) return;
      const root = picker.closest('.hdt-line-item-property') || picker.parentElement;
      const label = root?.querySelector('label[for]');
      const target = label || root || picker;
      try {
        target?.scrollIntoView?.({ behavior: 'smooth', block: 'center' });
      } catch (_) {}
      // picker is hidden, so focus label/root for better mobile UX
      try {
        if (label instanceof HTMLElement) {
          label.setAttribute('tabindex', '-1');
          label.focus({ preventScroll: true });
        } else if (root instanceof HTMLElement) {
          root.setAttribute('tabindex', '-1');
          root.focus({ preventScroll: true });
        } else {
          picker.focus?.({ preventScroll: true });
        }
      } catch (_) {}
    }

    function clearInlineValidationForForm(form) {
      const picker = getUploadPickerForForm(form);
      if (!picker) return;
      setInlineValidation(picker, '');
    }

    function getPetNameInput(form) {
      if (!form) return null;
      // Inputs can be outside <form> and linked via form="<id>", so use element.form mapping.
      const exactCandidates = Array.from(
        document.querySelectorAll('input[name="properties[Pet\'s name]"], textarea[name="properties[Pet\'s name]"]')
      );
      const exact = exactCandidates.find((el) => el.form === form);
      if (exact) return exact;

      // Fallback: any line-item property input/textarea linked to this form that looks like pet name
      const props = Array.from(
        document.querySelectorAll('input[name^="properties["], textarea[name^="properties["]')
      ).filter((el) => el.form === form);

      return props.find((i) => {
        const n = String(i.name || '').toLowerCase();
        return n.includes('pet') && n.includes('name');
      }) || null;
    }

    function shouldBlockForMissingUpload(form) {
      const picker = getUploadPickerForForm(form);
      if (!picker) return false; // no upload field on this product
      if (picker.dataset.required !== 'true') return false;
      return countUploadedFilesForForm(form) <= 0;
    }

    document.addEventListener('change', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement)) return;
      if (!t.classList.contains('hdt-upload-input')) return;
      const formId = t.dataset.productFormId;
      const form = formId ? document.getElementById(formId) : (t.form instanceof HTMLFormElement ? t.form : null);
      if (form) clearInlineValidationForForm(form);
    }, true);

    document.addEventListener('click', async (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;

      const btn = el.closest(SELECTOR_ATC_BUTTONS);
      if (!(btn instanceof HTMLElement)) return;

      const form = getFormFromSubmitButton(btn);
      if (!(form instanceof HTMLFormElement)) return;

      // Always control submit ourselves
      e.preventDefault();
      e.stopPropagation();

      // 1) Require upload
      if (shouldBlockForMissingUpload(form)) {
        const picker = getUploadPickerForForm(form);
        setInlineValidation(picker, 'Please upload at least 1 photo before adding to cart.');
        focusUploadArea(picker);
        await showPopup({
          title: 'Photo Required',
          message: 'Please upload at least 1 photo before adding this product to cart.',
          okText: 'Got it',
          okStyle: 'danger'
        });
        return;
      }

      // 2) Pet name confirm (optional field)
      const petName = getPetNameInput(form);
      const petNameValue = (petName?.value || '').trim();
      if (!petNameValue) {
        const ok = await showPopup({
          title: "Pet's Name Missing",
          message: "You haven't entered your pet's name. Do you want to add to cart anyway?",
          okText: 'Yes, continue',
          cancelText: 'No',
          okStyle: 'primary'
        });
        if (!ok) return;
      }

      // Continue: submit form (theme scripts will handle cart/add.js)
      try {
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.submit();
      } catch (_) {
        try { form.submit(); } catch (_) {}
      }
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Main product",
  "class": "hdt-section hdt-section--feature-product",
  "max_blocks": 1,
  "blocks": [
    {
      "type": "_group-product"
    },
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-product.settings.header_sticky_atc.content"
    },
    {
      "type": "checkbox",
      "id": "sticky_atc",
      "label": "t:sections.main-product.settings.sticky_atc.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-product.settings.header_fbt.content"
    },
    {
      "type": "product_list",
      "id": "product_list_fbt",
      "label": "t:sections.main-product.settings.product_list_fbt.label",
      "limit": 10
    },
    {
      "type": "color_scheme",
      "id": "fbt_color_scheme",
      "label": "Frequently Bought Together Color scheme"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    /*{
      "type": "range",
      "id": "space_lg",
      "label": "Vertical space",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "space_md",
      "label": "Tablet vertical space",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "space",
      "label": "Mobile vertical space",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "style.layout_panel",
      "id": "layout",
      "label": "Layout",
      "default": {
        "flex-direction": "row",
        "gap": "20px",
        "justify-content": "center",
        "align-items": "center",

        "@media (--mobile)": {
          "flex-wrap": "wrap"
        }
      }
    },*/
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_rate",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.all.padding.padding_rate",
      "default": 75
    }
  ]
}
{% endschema %}