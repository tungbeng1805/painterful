{%- comment -%}
  Renders a item cart page

  Accepts:
  - item: {Object} (required)
  - form_id: {String} (required)

  Usage:
  {%- render 'item-cart-page', item: item, form_id: form_id -%}
{%- endcomment -%}
{%- assign image  = item.image | default: settings.placeholder_img -%}
<hdt-line-item class="hdt-line-item{% if item.variant.id == gift_wrap_pr_id %} is-gift-wrap{% endif %}">
  <div class="hdt-page-cart__infos-wrap hdt-flex">
    <div class="hdt-page-cart__image">
      <a href="{{ item.url }}" class="hdt-page-cart__img hdt-block hdt-relative hdt-oh hdt-ratio" style="--aspect-ratioapt:{{ image.aspect_ratio | default: 0.6811989100817438 }}">
        {%- if image != blank -%}
          {{ image | image_url: width: image.width | image_tag: loading: 'lazy', width: image.width, height: image.height, sizes: '(max-width: 767px) 80px, 160px', widths: '80, 160' }}
        {%- else -%}
          <span class="hdt-page-cart__img-placeholder"></span>
        {%- endif -%}
      </a>
    </div>
    <div class="hdt-page-cart__info">
      <a href="{{ item.url }}" class="hdt-page-cart__title hdt-s-text">{{ item.product.title }}</a>
      {%- unless item.product.has_only_default_variant -%}<div class="hdt-page-cart__meta-variant hdt-text-sm hdt-font-normal hdt-s-text2 hdt-block">{{ item.variant.title | escape }}</div>{%- endunless -%}
      {% comment %} {%- if item_pr.has_only_default_variant == false -%}
        <div class="hdt-page-cart__edit">
          <a href="{{ item.url }}" rel="nofollow" class="hdt-inline-block hdt-s-text" data-action-quickshop data-no-instant><svg viewBox="0 0 14 16" width="14" height="16"><use href="#icon-cart-edit"/></svg></a>
        </div>
      {%- endif -%} {% endcomment %}
      {%- if item.properties.size != 0 -%}
        <ul class="hdt-page-cart__meta-propertyList hdt-s-text2">
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and property_first_char != '_' -%}

              {%- assign value = property.last -%}

              <li class="hdt-product-option hdt-product-details__item hdt-product-details__item--property">
                <span class="hdt-product-details__item-label">
                  <strong>{{ property.first }}:</strong>
                </span>

                <span class="hdt-product-details__item-value">
                  {%- liquid
                    assign values = value
                    if value.first and value.size
                      assign values = value
                    else
                      assign values = value | split: ','
                    endif
                  -%}

                  {%- for v in values -%}
                    {%- assign v_str = v | strip -%}
                    {%- assign image_url = blank -%}
                    {%- if v_str contains '/uploads/' -%}
                      {%- assign image_url = v_str -%}
                    {%- elsif v_str contains '.png' or v_str contains '.jpg' or v_str contains '.jpeg' or v_str contains '.webp' or v_str contains '.heic' -%}
                      {%- assign image_url = '/uploads/' | append: v_str -%}
                    {%- endif -%}

                    {%- if image_url != blank -%}
                      <img
                        src="{{ image_url }}"
                        alt="{{ property.first }}"
                        loading="lazy"
                        width="40"
                        height="40"
                        class="hdt-upload-lightbox"
                        data-hdt-lightbox-src="{{ image_url }}"
                        style="max-width:40px;height:auto;border-radius:6px;margin-left:6px;"
                      >
                    {%- elsif forloop.first -%}
                      {{ value }}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </li>

            {%- endif -%}
          {%- endfor -%}

        </ul>
      {%- endif -%}
      {%- if item.line_level_discount_allocations.size != 0 -%}
        <ul class="hdt-discounts hdt-cart_discounts hdt-font-normal" role="list" aria-label="{{ 'customer.order.discount' | t }}">
          {%- for discount in item.line_level_discount_allocations -%}
            <li class="hdt-discounts__discount hdt-page-cart-discount_item">{% render 'icon' with 'discount' %} {{ discount.discount_application.title }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if item.selling_plan_allocation != null %}<p class="hdt-product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>{% endif -%}
      <wrapp-remove-item-oncart data-index="{{ item.index | plus: 1 }}" form="{{ form_id }}" href="{{ routes.cart_change_url }}?line={{ item.index | plus: 1 }}&quantity=0" class="hdt-page-cart__remove hdt-inline-block hdt-s-text"><span aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">{{ 'sections.cart.remove' | t }}</span></wrapp-remove-item-oncart>
    </div>
  </div>
</hdt-line-item>

<style>
  .hdt-upload-lightbox { cursor: zoom-in; }
  .hdt-lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.72);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 9999;
  }
  .hdt-lightbox-dialog {
    position: relative;
    max-width: min(980px, 92vw);
    max-height: 86vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hdt-lightbox-img {
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    background: #fff;
    object-fit: contain;
  }
  .hdt-lightbox-close {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    color: #111;
    cursor: pointer;
    font-size: 18px;
    line-height: 36px;
    text-align: center;
    box-shadow: 0 8px 20px rgba(0,0,0,.25);
  }
  @media (max-width: 767px) {
    .hdt-lightbox-overlay { padding: 10px; }
    .hdt-lightbox-dialog { max-width: 96vw; max-height: 82vh; }
    .hdt-lightbox-img { max-height: 82vh; border-radius: 8px; }
    .hdt-lightbox-close { top: -8px; right: -8px; width: 34px; height: 34px; line-height: 34px; }
  }
</style>

<script>
  (() => {
    if (window.__hdtCartLightboxInit) return;
    window.__hdtCartLightboxInit = true;

    const createModal = () => {
      const overlay = document.createElement('div');
      overlay.className = 'hdt-lightbox-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.hidden = true;

      const dialog = document.createElement('div');
      dialog.className = 'hdt-lightbox-dialog';

      const img = document.createElement('img');
      img.className = 'hdt-lightbox-img';
      img.alt = '';

      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'hdt-lightbox-close';
      close.setAttribute('aria-label', 'Close');
      close.innerHTML = '✕';

      dialog.appendChild(img);
      dialog.appendChild(close);
      overlay.appendChild(dialog);
      document.body.appendChild(overlay);

      const doClose = () => {
        overlay.hidden = true;
        img.src = '';
        document.body.style.overflow = '';
      };
      close.addEventListener('click', doClose);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) doClose();
      });
      document.addEventListener('keydown', (e) => {
        if (!overlay.hidden && e.key === 'Escape') doClose();
      });

      return {
        open: (src, alt) => {
          img.src = src;
          img.alt = alt || '';
          overlay.hidden = false;
          document.body.style.overflow = 'hidden';
        }
      };
    };

    let modal;
    document.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;
      const img = el.closest('img.hdt-upload-lightbox');
      if (!img) return;
      const src = img.getAttribute('data-hdt-lightbox-src') || img.getAttribute('src');
      if (!src) return;
      modal ||= createModal();
      modal.open(src, img.getAttribute('alt'));
    }, true);
  })();
</script>